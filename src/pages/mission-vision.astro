---
import BaseLayout from "../layouts/BaseLayout.astro";
import missionHero from "../assets/img/mission-hero.png";

const title = "Mission & Vision | ASquare";
const description =
  "ASquare’s mission and vision: empower organizations with technology that is reliable, scalable, and human-centered.";

const principles = [
  {
    title: "We write it down",
    desc: "Decisions, trade-offs, and risks are documented before they're verbal. Nothing important should only exist in a call recording.",
  },
  {
    title: "We finish what we start",
    desc: "We don't orphan projects. If scope changes, we say so explicitly. Silent pivots are a trust debt we don't carry.",
  },
  {
    title: "We read before we recommend",
    desc: "Every proposal starts with reading the existing documentation, schema, or codebase. Not assuming.",
  },
  {
    title: "We prefer boring infrastructure",
    desc: "Kubernetes for the container problem, Postgres for the data problem. New technology where it earns its place, not by default.",
  },
];
---

<BaseLayout title={title} description={description}>
  <section class="hero-section gutter">
    <div class="wrap hero-inner">
      <div class="hero-heading">
        <span class="breadcrumb-label">Home / Mission &amp; Vision</span>
        <h1>Our Mission &amp; Vision</h1>
      </div>
      <div class="hero-image">
        <img src={missionHero.src} alt="ASquare team at work" />
      </div>
      <div class="mission-grid">
        <div class="mission-col">
          <div class="mission-col-heading">
            <span class="eyebrow">Our Mission</span>
            <h2>Make complex systems work for the people who run them</h2>
          </div>
          <p>
            Enterprise software has a reputation for being hostile to the people
            who use it most. We build and maintain the integrations,
            applications, and data environments that close that gap. Not for the
            boardroom demo — for the operations manager who has 40 windows open
            and needs the right number on the first click.
          </p>
        </div>
        <div class="mission-col">
          <div class="mission-col-heading">
            <span class="eyebrow">Our Vision</span>
            <h2>A world where ERP data reaches every decision it should</h2>
          </div>
          <p>
            Most enterprise data is trapped — in systems that don't talk to each
            other, in reports that take five days to produce, in spreadsheets
            exported weekly as a workaround. We're working toward a model where
            that data flows cleanly, in real time, to the surface where it's
            needed. That's not an AI pitch. It's just good engineering.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="principles-section gutter">
    <div class="wrap principles-inner">
      <div class="section-heading">
        <span class="eyebrow">How we operate</span>
        <h2>Principles that drive our engineering</h2>
      </div>
      <div class="principles-grid">
        {
          principles.map((p) => (
            <div class="card principle-card">
              <i data-lucide="edit-3" aria-hidden="true" />
              <div class="principle-body">
                <span class="principle-title">{p.title}</span>
                <span class="principle-desc">{p.desc}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cta-section gutter">
    <div class="cta-copy">
      <h2>Work with a team that thinks this way</h2>
      <p>We scope projects in a single call. No long sales cycles.</p>
    </div>
    <a href="/contact" class="btn-outline">Talk to us</a>
  </section>
</BaseLayout>

<style>
  .hero-section {
    padding-block: 190px 120px;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: 60px;
  }

  .hero-heading {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .breadcrumb-label {
    font-weight: 400;
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(110, 116, 126);
    text-transform: uppercase;
  }

  .hero-heading h1 {
    font-weight: 700;
    font-size: clamp(32px, 5vw, 56px);
    color: var(--text);
  }

  .hero-image {
    height: 360px;
    border-radius: 16px;
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mission-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
  }

  .mission-col {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .mission-col-heading {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .eyebrow {
    font-weight: 700;
    font-size: 14px;
    color: var(--accent);
    text-transform: uppercase;
  }

  .mission-col-heading h2 {
    font-weight: 700;
    font-size: 28px;
    line-height: 1.2;
    color: var(--text);
  }

  .mission-col p {
    font-weight: 400;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .principles-section {
    padding-block: 120px;
  }

  .principles-inner {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .section-heading {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .section-heading h2 {
    font-weight: 700;
    font-size: clamp(28px, 4vw, 40px);
    color: var(--text);
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .principle-card {
    border-radius: 4px;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--border);
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .principle-card :global(svg) {
    width: 32px;
    height: 32px;
    color: var(--accent);
  }

  .principle-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .principle-title {
    font-weight: 600;
    font-size: 20px;
    color: var(--text);
  }

  .principle-desc {
    font-weight: 400;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .cta-section {
    background: var(--accent);
    padding-block: 120px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    text-align: center;
  }

  .cta-copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 661px;
  }

  .cta-copy h2 {
    font-weight: 700;
    font-size: clamp(28px, 5vw, 48px);
    color: #fff;
  }

  .cta-copy p {
    font-weight: 400;
    font-size: 18px;
    color: rgba(255, 255, 255, 0.8);
  }

  .btn-outline {
    display: inline-block;
    background: transparent;
    color: #fff;
    border: 1px solid #fff;
    font-weight: 600;
    font-size: 16px;
    padding: 16px 32px;
    border-radius: 4px;
  }

  .btn-outline:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }

  @media (max-width: 900px) {
    .hero-section {
      padding-top: 110px;
    }

    .hero-image {
      height: 220px;
    }

    .mission-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }
</style>
