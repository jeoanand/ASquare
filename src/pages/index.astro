---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBanner from "../components/CtaBanner.astro";
import heroBg from "../assets/img/homepage-hero.jpg";
import techStack from "../assets/img/tech-stack.png";
import sandraObi from "../assets/img/testimonial-1.png";
import jamesHarlow from "../assets/img/testimonial-2.png";
import marcusFlynn from "../assets/img/testimonial-3.png";

import awsLogo from "../assets/img/aws.png";
import azureLogo from "../assets/img/microsoft-azure.png";
import cloudflareLogo from "../assets/img/cloudflare.png";
import appleLogo from "../assets/img/apple-logo.png";
import atlassianLogo from "../assets/img/atlassian.png";
import databricksLogo from "../assets/img/databricks.png";
import dockerLogo from "../assets/img/docker.png";

const logos = [
  { name: "AWS", src: awsLogo },
  { name: "Microsoft Azure", src: azureLogo },
  { name: "Cloudflare", src: cloudflareLogo },
  { name: "Apple", src: appleLogo },
  { name: "Atlassian", src: atlassianLogo },
  { name: "Databricks", src: databricksLogo },
  { name: "Docker", src: dockerLogo },
];

const title = "ASquare | Technology Solutions for Modern Businesses";
const description =
  "ASquare delivers custom software development, data engineering & BI, cloud & DevOps engineering, software modernization, IT services, and Infor XA ERP solutions.";

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "ASquare",
  url: Astro.site?.href ?? Astro.url.origin,
  description,
};

const stats = [
  { v: "12+", l: "Years operating" },
  { v: "80+", l: "Projects delivered" },
  { v: "99.7%", l: "Client system uptime" },
];

const capabilities = [
  {
    icon: "database",
    title: "Infor XA ERP",
    bullets: [
      "Supporting and modernising your core enterprise platform.",
      "System upgrades and legacy migration.",
      "Custom module development and configuration.",
      "Ongoing maintenance and technical support.",
    ],
  },
  {
    icon: "code-2",
    title: "Custom Software Development",
    bullets: [
      "Mission-critical web applications and mobile products.",
      "API development and third-party integrations.",
      "Cloud deployment, scaling, and security by design.",
    ],
  },
  {
    icon: "bar-chart-3",
    title: "Data Engineering & BI",
    bullets: [
      "Reliable data pipelines and automated ETL.",
      "Interactive dashboards and real-time reporting.",
      "Data warehouse design and dimensional modeling.",
      "Operational and financial analytics.",
    ],
  },
  {
    icon: "cloud",
    title: "Cloud & DevOps Engineering",
    bullets: [
      "Robust Azure and AWS environments for critical workloads.",
      "CI/CD automation and Infrastructure as Code.",
      "Docker and Kubernetes orchestration.",
      "Observability, security, and disaster recovery.",
    ],
  },
  {
    icon: "refresh-cw",
    title: "Software Modernization",
    bullets: [
      "Legacy application and architecture modernization.",
      "Monolith decoupling and microservices migration.",
      "Database and data performance optimization.",
      "Cloud migration for legacy workloads.",
    ],
  },
  {
    icon: "briefcase",
    title: "IT Consulting",
    bullets: [
      "Technical leadership for architecture and strategy.",
      "Digital transformation roadmap planning.",
      "Vendor evaluation and technology selection.",
      "Team augmentation and project management.",
    ],
  },
];

const reasons = [
  {
    n: "1",
    title: "ERP-native web development",
    desc: "We build interfaces that speak directly to Infor XA data structures, not generic REST wrappers.",
  },
  {
    n: "2",
    title: "AI in production, not in demos",
    desc: "We deploy models that integrate with your existing ERP and cloud stack, not standalone experiments.",
  },
  {
    n: "3",
    title: "One team across the full stack",
    desc: "No handoffs between an SI and an agency. Web, data, cloud, and ERP under the same engagement.",
  },
];

const caseStats = [
  { v: "5 Days → 4 Hours", l: "Reporting cycle time" },
  { v: "100%", l: "Data accuracy" },
  { v: "$240K", l: "Annual savings" },
];

const testimonials = [
  {
    quote:
      "We had Infor XA data in three separate spreadsheets. ASquare connected everything to Power BI in 6 weeks and we haven't touched a spreadsheet since.",
    photo: jamesHarlow,
    initials: "JH",
    name: "James Harlow",
    role: "Head of Operations, Meridian Group",
  },
  {
    quote:
      "Most consultants want to sell you a new system. These engineers actually read your existing setup and told us what to fix first. Rare.",
    photo: sandraObi,
    initials: "SO",
    name: "Sandra Obi",
    role: "IT Director, Apex Industries",
  },
  {
    quote:
      "The reporting pipeline they built writes directly to our ERP. That's not something we could have found off the shelf.",
    photo: marcusFlynn,
    initials: "MF",
    name: "Marcus Flynn",
    role: "CTO, CoreTech Solutions",
  },
];
---

<BaseLayout title={title} description={description} heroHeader>
  <Fragment slot="jsonld">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationJsonLd)}
    />
  </Fragment>

  <div class="page-home">
    <section class="hero">
      <div
        class="hero-overlay"
        style={`background-image:linear-gradient(rgba(15,23,42,0.65),rgba(15,23,42,0.65)), url(${heroBg.src})`}
      >
      </div>
      <div class="hero-content wrap gutter">
        <div class="hero-copy">
          <h1>Building Intelligent Solutions for a Connected Future</h1>
          <p>
            Enterprise-grade web, AI, and ERP engineering for operations teams
            that can't afford downtime.
          </p>
        </div>
        <div class="hero-actions">
          <a href="/contact" class="btn-primary">Talk to us</a>
          <a href="/services" class="btn-outline">See our work</a>
        </div>
      </div>
    </section>

    <section class="logos-section gutter">
      <div class="wrap logos-inner">
        <div class="logo-row">
          {
            logos.map((logo) => (
              <img
                class="logo-item"
                data-logo={logo.name}
                src={logo.src.src}
                alt={logo.name}
                loading="lazy"
              />
            ))
          }
        </div>
        <div class="stats-row">
          {
            stats.map((s) => (
              <div class="stat">
                <span class="stat-value">{s.v}</span>
                <span class="stat-label">{s.l}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="capabilities-section gutter">
      <div class="wrap capabilities-inner">
        <div class="section-heading">
          <span class="eyebrow">Capabilities</span>
          <h2>What we build and run</h2>
        </div>
        <div class="capabilities-grid">
          {
            capabilities.map((cap) => (
              <div class="card capability-card">
                <div class="capability-top">
                  <div class="capability-icon">
                    <i data-lucide={cap.icon} aria-hidden="true" />
                  </div>
                  <div class="capability-body">
                    <span class="capability-title">{cap.title}</span>
                    <div class="capability-bullets">
                      {cap.bullets.map((b) => (
                        <div>{b}</div>
                      ))}
                    </div>
                  </div>
                </div>
                <div class="capability-arrow">
                  <i data-lucide="arrow-up-right" aria-hidden="true" />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="reasons-section gutter">
      <div class="wrap reasons-inner">
        <h2>Why teams choose us</h2>
        <div class="reasons-grid">
          {
            reasons.map((r) => (
              <div class="reason">
                <span class="reason-number">{r.n}</span>
                <div class="reason-body">
                  <span class="reason-title">{r.title}</span>
                  <span class="reason-desc">{r.desc}</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="tech-stack-section gutter">
      <div class="wrap tech-stack-inner">
        <div class="section-heading">
          <!-- <span class="eyebrow">Tech Stack</span> -->
          <!-- <h2>The complete stack we build and run on</h2> -->
          <!-- <p class="tech-stack-lead">
            From responsive frontends and cross-platform mobile apps to scalable
            backends, databases, DevOps, and AI integration — plus end-to-end
            Infor XA ERP.
          </p> -->
        </div>
        <figure class="tech-stack-figure">
          <Image
            src={techStack}
            alt="A-Square technology stack: Frontend (Angular, React, Vue.js, Next.js, TypeScript, HTML5, CSS3, Tailwind CSS), Mobile (Flutter, React Native, Android Studio, Xcode), Backend (Node.js, .NET Core, Java, Python, Next.js), Database (Microsoft SQL Server, MySQL, PostgreSQL, MongoDB, Redis, IBM Db2), DevOps (GitLab, Jenkins, Docker, Kubernetes, Terraform, AWS, Microsoft Azure), Management (Jira, Confluence, Slack, Microsoft Teams, Bitbucket, Notion), AI Integration (ChatGPT, Claude, Google Gemini, Microsoft Copilot, Perplexity, DALL-E), and Infor XA ERP."
            widths={[640, 960, 1280, 1720]}
            sizes="(max-width: 1200px) 100vw, 1200px"
            loading="lazy"
          />
        </figure>
      </div>
    </section>

    <section class="case-section gutter">
      <div class="wrap case-inner">
        <div class="case-copy">
          <div class="section-heading">
            <span class="eyebrow eyebrow-sm">Case Study</span>
            <h2>Cutting reporting time from 5 days to 4 hours</h2>
          </div>
          <div class="case-paragraphs">
            <p>
              Legacy reporting systems were creating a 5-day lag between shop
              floor reality and executive visibility. The manual extraction from
              Infor XA was prone to error.
            </p>
            <p>
              We architected a direct Power BI integration that normalised XA
              data in real-time. The result was immediate operational
              transparency across three global plants.
            </p>
          </div>
        </div>
        <div class="case-stats">
          {
            caseStats.map((s) => (
              <div class="case-stat">
                <span class="case-stat-value">{s.v}</span>
                <span class="case-stat-label">{s.l}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="testimonials-section gutter">
      <div class="wrap testimonials-inner">
        <div class="section-heading">
          <span class="eyebrow">What clients say</span>
          <h2>Real feedback from operations teams</h2>
        </div>
        <div class="testimonials-grid">
          {
            testimonials.map((t) => (
              <div class="testimonial-card">
                <i data-lucide="quote" aria-hidden="true" />
                <p>{t.quote}</p>
                <div class="testimonial-person">
                  <div class="testimonial-avatar">
                    {t.photo ? (
                      <Image
                        src={t.photo}
                        alt={`Portrait of ${t.name}`}
                        width={80}
                        height={80}
                        loading="lazy"
                      />
                    ) : (
                      <span>{t.initials}</span>
                    )}
                  </div>
                  <div class="testimonial-meta">
                    <span class="testimonial-name">{t.name}</span>
                    <span class="testimonial-role">{t.role}</span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <CtaBanner />
  </div>
</BaseLayout>
