---
import ServiceDetail from "../../components/ServiceDetail.astro";
import heroImg from "../../assets/img/cloud-hero.png";
import relatedAi from "../../assets/img/related-ai.png";
import relatedCloud from "../../assets/img/related-cloud.png";
import { getServiceBySlug } from "../../data/services.js";

const service = getServiceBySlug("cloud-services");
if (!service) throw new Error("Service not found");

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  description: service.description,
  provider: { "@type": "Organization", name: "ASquare" },
};

const capabilities = [
  {
    icon: "cloud",
    title: "Cloud Migration & Hybrid Integration",
    desc: "Modernize on-premise workloads, applications, servers, and databases by moving them toward AWS, Azure, or hybrid cloud using a structured migration strategy.",
  },
  {
    icon: "file-code",
    title: "Infrastructure as Code",
    desc: "Automate infrastructure provisioning and configuration using declarative approaches for consistent, repeatable environments.",
  },
  {
    icon: "refresh-cw",
    title: "CI/CD Pipeline Engineering",
    desc: "Design automated build, test, deployment, and release pipelines for applications built with .NET, Node.js, Angular, and Flutter.",
  },
  {
    icon: "box",
    title: "Docker & Kubernetes",
    desc: "Containerize applications and implement orchestration strategies to improve portability, deployment consistency, and scalability.",
  },
  {
    icon: "trending-down",
    title: "Cloud Cost & Performance Optimization",
    desc: "Analyze infrastructure utilization, workloads, and cloud resources to identify right-sizing and cost efficiency opportunities.",
  },
  {
    icon: "life-buoy",
    title: "High Availability & Disaster Recovery",
    desc: "Design backup, redundancy, failover, and business continuity strategies appropriate to your availability requirements.",
  },
];

const steps = [
  {
    n: "01",
    title: "Cloud Architecture & Infrastructure as Code",
    desc: "We design cloud environments across AWS and Azure and use Infrastructure as Code to automate provisioning, configuration, and environment management for consistent, repeatable results.",
  },
  {
    n: "02",
    title: "CI/CD & Release Automation",
    desc: "We build automated pipelines for development, testing, deployment, and release management across web, backend, and mobile applications — shorter release cycles, fewer errors.",
  },
  {
    n: "03",
    title: "Containerization & Orchestration",
    desc: "We containerize applications with Docker and implement orchestration platforms like Kubernetes for consistency across development, staging, and production.",
  },
  {
    n: "04",
    title: "Observability, Security & Operations",
    desc: "We implement centralized logging, monitoring, automated alerts, access controls, and secrets management for earlier issue detection and faster incident response.",
  },
];

const techGroups = [
  { title: "Cloud Platforms", items: ["Microsoft Azure", "AWS", "Hybrid Cloud"] },
  { title: "Containers & Orchestration", items: ["Docker", "Kubernetes"] },
  {
    title: "CI/CD & DevOps",
    items: ["GitHub Actions", "GitLab CI/CD", "Azure DevOps", "Jenkins"],
  },
  {
    title: "Infrastructure as Code",
    items: ["Terraform", "Cloud-native IaC tools"],
  },
  {
    title: "Monitoring & Observability",
    items: ["Application Monitoring", "Infrastructure Monitoring", "Centralized Logging"],
  },
  {
    title: "Development Ecosystem",
    items: [".NET / ASP.NET Core", "Node.js", "Angular", "React", "Flutter"],
  },
];

const related = [
  {
    icon: "briefcase",
    title: "IT Consulting",
    desc: "Technical leadership for architecture and strategy across your cloud infrastructure.",
    href: "/services/it-services",
    imgSrc: relatedAi.src,
  },
  {
    icon: "refresh-cw",
    title: "Software Modernization & Refactoring",
    desc: "Modernize legacy workloads and move them toward the cloud environments we build and manage.",
    href: "/services/software-modernization",
    imgSrc: relatedCloud.src,
  },
];
---

<ServiceDetail
  title={service.metaTitle}
  description={service.metaDescription}
  heroImageSrc={heroImg.src}
  heroHeading="Build faster, deploy smarter, operate with confidence."
  heroSubtitle="Cloud architecture, CI/CD automation, containerization, and observability — engineering foundations for teams that release software faster and operate it more reliably."
  heroCtaLabel="Talk to us about your infrastructure"
  breadcrumbLabel="Cloud & DevOps Engineering"
  capabilities={capabilities}
  steps={steps}
  hasTechStack
  techGroups={techGroups}
  related={related}
  ctaHeading="Let's build your cloud & DevOps strategy"
  ctaSubtitle="Automate delivery, modernize infrastructure, and build cloud environments ready for your next stage of growth."
  ctaButtonLabel="Request a review"
>
  <Fragment slot="jsonld">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(serviceJsonLd)}
    />
  </Fragment>
</ServiceDetail>
