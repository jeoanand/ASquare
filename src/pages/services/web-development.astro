---
import ServiceDetail from "../../components/ServiceDetail.astro";
import heroImg from "../../assets/img/web-dev-hero.png";
import relatedAi from "../../assets/img/related-ai.png";
import relatedCloud from "../../assets/img/related-cloud.png";
import { getServiceBySlug } from "../../data/services.js";

const service = getServiceBySlug("web-development");
if (!service) throw new Error("Service not found");

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  description: service.description,
  provider: { "@type": "Organization", name: "ASquare" },
};

const capabilities = [
  {
    icon: "layers",
    title: "Custom Web Applications",
    desc: "Full-stack web apps tailored to your business logic, from dashboards to customer portals.",
  },
  {
    icon: "shopping-cart",
    title: "E-Commerce Solutions",
    desc: "Scalable online stores with payment integration, inventory management, and analytics.",
  },
  {
    icon: "smartphone",
    title: "Progressive Web Apps",
    desc: "Fast, reliable, installable web experiences that work offline and feel native.",
  },
  {
    icon: "code-2",
    title: "API Development",
    desc: "RESTful and GraphQL APIs built for reliability, security, and third-party integration.",
  },
  {
    icon: "cloud",
    title: "Cloud & DevOps",
    desc: "CI/CD pipelines, containerization, and cloud infrastructure on Azure, AWS, or GCP.",
  },
  {
    icon: "shield",
    title: "Enterprise Portals",
    desc: "Secure internal tools, admin panels, and workflow automation for large teams.",
  },
];

const steps = [
  {
    n: "01",
    title: "Discovery",
    desc: "We map your data model and existing integrations before writing a line of code. This prevents the classic rewrite 18 months later.",
  },
  {
    n: "02",
    title: "Architecture",
    desc: "We design the system to your actual load and security requirements. No over-engineering, no shortcuts.",
  },
  {
    n: "03",
    title: "Build & Iterate",
    desc: "Staged delivery against a fixed scope. You see working software every 2 weeks, not a big reveal.",
  },
  {
    n: "04",
    title: "Operate & Support",
    desc: "We stay engaged post-launch. Updates, bug fixes, and infrastructure management on a transparent retainer.",
  },
];

const techGroups = [
  {
    title: "Web Apps",
    items: ["Next.js", "Angular", "Vue.js", "Node.js", ".NET"],
  },
  { title: "Mobile Apps", items: ["Flutter", "Swift", "Kotlin"] },
  { title: "Blockchain", items: ["Ethereum", "Hyperledger", "Web3.js"] },
  {
    title: "Cloud & Infrastructure",
    items: ["Azure", "GCP", "Docker", "Kubernetes"],
  },
  { title: "Databases", items: ["MongoDB", "Redis", "SQL Server"] },
  { title: "AI & Data", items: ["TensorFlow", "Power BI", "Tableau"] },
];

const related = [
  {
    icon: "brain-circuit",
    title: "AI Integration",
    desc: "Deploying models that drive real operational value across your ERP and cloud stack.",
    href: "/services/ai-integration",
    imgSrc: relatedAi.src,
  },
  {
    icon: "cloud",
    title: "Cloud Services",
    desc: "Robust Azure and AWS environments engineered for critical, always-on workloads.",
    href: "/services/cloud-services",
    imgSrc: relatedCloud.src,
  },
];
---

<ServiceDetail
  title={service.metaTitle}
  description={service.metaDescription}
  heroImageSrc={heroImg.src}
  heroHeading="Production web applications built to last."
  heroSubtitle="From Infor XA-integrated portals to standalone SaaS products — engineered, not assembled."
  heroCtaLabel="Talk to us about your project"
  breadcrumbLabel="Web Development"
  capabilities={capabilities}
  steps={steps}
  hasTechStack
  techGroups={techGroups}
  approachTinted
  related={related}
  ctaHeading="Talk to us about your web project"
  ctaSubtitle="We scope in a single call. No pitch deck required."
  ctaButtonLabel="Start a conversation"
>
  <Fragment slot="jsonld">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(serviceJsonLd)}
    />
  </Fragment>
</ServiceDetail>
