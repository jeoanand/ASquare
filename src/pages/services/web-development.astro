---
import ServiceDetail from "../../components/ServiceDetail.astro";
import heroImg from "../../assets/img/web-dev-hero.png";
import relatedAi from "../../assets/img/related-ai.png";
import relatedCloud from "../../assets/img/related-cloud.png";
import { getServiceBySlug } from "../../data/services.js";

const service = getServiceBySlug("web-development");
if (!service) throw new Error("Service not found");

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  description: service.description,
  provider: { "@type": "Organization", name: "ASquare" },
};

const capabilities = [
  {
    icon: "rocket",
    title: "New Digital Products",
    desc: "Build new digital products from the ground up, from mission-critical web applications to cross-platform mobile products.",
  },
  {
    icon: "refresh-cw",
    title: "Legacy Modernization",
    desc: "Modernize legacy applications and architectures without unnecessarily disrupting the business logic you depend on.",
  },
  {
    icon: "smartphone",
    title: "Web & Mobile Applications",
    desc: "Develop scalable web and mobile applications using modern backend, web, and mobile technologies.",
  },
  {
    icon: "link",
    title: "API & Systems Integration",
    desc: "Integrate APIs, third-party platforms, databases, legacy systems, and enterprise infrastructure.",
  },
  {
    icon: "cloud",
    title: "Cloud Deployment & Scaling",
    desc: "Deploy using modern cloud and containerization practices across AWS and Azure, with monitoring built in.",
  },
  {
    icon: "shield",
    title: "Security by Design",
    desc: "Secure authentication, authorization, encryption, and access controls built in from the architecture stage onward.",
  },
];

const steps = [
  {
    n: "01",
    title: "Architectural Blueprinting",
    desc: "We analyze your business requirements, map application domains and dependencies, define the technical architecture, and select the right technology stack.",
  },
  {
    n: "02",
    title: "Continuous-Delivery Engineering",
    desc: "Our engineers build clean, modular, and maintainable code using modern backend, web, and mobile technologies, organized into iterative sprints so you can review progress and refine priorities.",
  },
  {
    n: "03",
    title: "System Integration & Quality Engineering",
    desc: "We integrate APIs, third-party platforms, databases, legacy systems, and enterprise infrastructure while applying automated testing, performance validation, and security checks.",
  },
  {
    n: "04",
    title: "Cloud Deployment & Scaling",
    desc: "We deploy using modern cloud and containerization practices across AWS and Azure, with monitoring and operational considerations built in as usage grows.",
  },
];

const techGroups = [
  { title: "Backend", items: [".NET / ASP.NET Core", "Node.js"] },
  { title: "Web & Mobile", items: ["Angular", "React", "Flutter"] },
  {
    title: "Cloud & Infrastructure",
    items: ["AWS", "Microsoft Azure", "Docker", "Kubernetes"],
  },
];

const related = [
  {
    icon: "refresh-cw",
    title: "Software Modernization & Refactoring",
    desc: "Modernize legacy applications and architectures your team already depends on.",
    href: "/services/software-modernization",
    imgSrc: relatedAi.src,
  },
  {
    icon: "cloud",
    title: "Cloud & DevOps Engineering",
    desc: "Robust Azure and AWS environments engineered for critical, always-on workloads.",
    href: "/services/cloud-services",
    imgSrc: relatedCloud.src,
  },
];
---

<ServiceDetail
  title={service.metaTitle}
  description={service.metaDescription}
  heroImageSrc={heroImg.src}
  heroHeading="Transform complex requirements into scalable software."
  heroSubtitle="From mission-critical web applications to cross-platform mobile products — secure, resilient, and built for long-term growth."
  heroCtaLabel="Talk to us about your project"
  breadcrumbLabel="Custom Software Development"
  capabilities={capabilities}
  steps={steps}
  hasTechStack
  techGroups={techGroups}
  approachTinted
  related={related}
  ctaHeading="Let's build what's next"
  ctaSubtitle="Partner with ASquare to turn your software vision into a scalable digital product."
  ctaButtonLabel="Start a conversation"
>
  <Fragment slot="jsonld">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(serviceJsonLd)}
    />
  </Fragment>
</ServiceDetail>
