---
import ServiceDetail from "../../components/ServiceDetail.astro";
import heroImg from "../../assets/img/powerbi-hero.png";
import relatedAi from "../../assets/img/related-ai.png";
import relatedCloud from "../../assets/img/related-cloud.png";
import { getServiceBySlug } from "../../data/services.js";

const service = getServiceBySlug("power-bi");
if (!service) throw new Error("Service not found");

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  description: service.description,
  provider: { "@type": "Organization", name: "ASquare" },
};

const capabilities = [
  {
    icon: "workflow",
    title: "Data Pipeline Engineering",
    desc: "Build reliable and maintainable pipelines for extracting, transforming, validating, and delivering data across your technology ecosystem.",
  },
  {
    icon: "refresh-cw",
    title: "ETL & Data Transformation",
    desc: "Automate complex data transformations, cleansing, schema mapping, validation, and enrichment processes.",
  },
  {
    icon: "database",
    title: "Database & Query Optimization",
    desc: "Improve data access and processing efficiency through query optimization, indexing, schema improvements, and performance engineering.",
  },
  {
    icon: "server",
    title: "Data Warehousing & Modeling",
    desc: "Design structured data platforms using appropriate warehouse architectures and dimensional modeling to support reporting and analytics.",
  },
  {
    icon: "layout-dashboard",
    title: "Business Intelligence Dashboards",
    desc: "Create interactive dashboards and reports that let teams monitor KPIs, explore trends, and make data-driven decisions.",
  },
  {
    icon: "trending-up",
    title: "Operational & Financial Analytics",
    desc: "Bring together data from finance, sales, operations, supply chain, and customer service into a unified view of business performance.",
  },
];

const steps = [
  {
    n: "01",
    title: "Data Source Ingestion",
    desc: "We connect and ingest data from relational databases, business applications, APIs, CRM platforms, and cloud storage into a unified foundation that reduces fragmented information.",
  },
  {
    n: "02",
    title: "ETL & Data Transformation",
    desc: "We design automated extraction, transformation, and loading processes to clean, validate, standardize, and enrich data your teams can rely on.",
  },
  {
    n: "03",
    title: "Data Warehousing & Modeling",
    desc: "We design data warehouses and analytical models using dimensional modeling, indexing, and performance optimization for faster, more reliable reporting.",
  },
  {
    n: "04",
    title: "Business Intelligence & Visualization",
    desc: "We build interactive dashboards, KPI reports, and automated reporting that give leaders clear visibility into performance, revenue, and costs.",
  },
];

const techGroups = [
  {
    title: "Databases & Storage",
    items: ["SQL Server", "PostgreSQL", "MySQL", "Oracle", "MongoDB"],
  },
  {
    title: "Data Engineering",
    items: ["SQL / T-SQL", "Python", "ETL / ELT", "REST APIs"],
  },
  {
    title: "Cloud & Data Platforms",
    items: ["Azure", "AWS", "Data Warehousing"],
  },
  {
    title: "BI & Visualization",
    items: ["Power BI", "Tableau", "Automated Reporting"],
  },
];

const whyPoints = [
  {
    icon: "settings",
    title: "Engineering-First Approach",
    desc: "We don't treat analytics as simply a dashboard-building exercise. We focus on the underlying data architecture, pipelines, databases, and integrations that make reliable analytics possible.",
  },
  {
    icon: "target",
    title: "Business-Focused Analytics",
    desc: "We connect technical implementation with business objectives, helping ensure dashboards and reports focus on meaningful KPIs rather than unnecessary metrics.",
  },
  {
    icon: "trending-up",
    title: "Scalable Architecture",
    desc: "Our data solutions are designed with future growth in mind, allowing your data environment to evolve as sources, users, and analytical requirements increase.",
  },
  {
    icon: "shield",
    title: "Security & Governance",
    desc: "We incorporate appropriate access controls, data protection, authentication, and auditability into data platforms based on your business and security requirements.",
  },
];

const related = [
  {
    icon: "database",
    title: "Infor XA ERP",
    desc: "Support, extend, and modernise Infor XA deployments feeding your data models.",
    href: "/services/infor-xa-erp",
    imgSrc: relatedAi.src,
  },
  {
    icon: "cloud",
    title: "Cloud & DevOps Engineering",
    desc: "Robust Azure and AWS environments engineered to host your reporting and data layer.",
    href: "/services/cloud-services",
    imgSrc: relatedCloud.src,
  },
];
---

<ServiceDetail
  title={service.metaTitle}
  description={service.metaDescription}
  heroImageSrc={heroImg.src}
  heroHeading="Turn fragmented data into actionable business intelligence."
  heroSubtitle="Reliable data pipelines, modern data platforms, and interactive dashboards that turn disconnected information into trusted business intelligence."
  heroCtaLabel="Talk to us about your data"
  breadcrumbLabel="Data Engineering & BI"
  capabilities={capabilities}
  steps={steps}
  approachTinted
  hasTechStack
  techGroups={techGroups}
  whyPoints={whyPoints}
  related={related}
  ctaHeading="Ready to make better use of your data?"
  ctaSubtitle="Let's build your data platform."
  ctaButtonLabel="Book a data audit"
>
  <Fragment slot="jsonld">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(serviceJsonLd)}
    />
  </Fragment>
</ServiceDetail>
