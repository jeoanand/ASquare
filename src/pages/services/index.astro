---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import servicesHero from "../../assets/img/services-hero.png";
import ourProcess from "../../assets/img/our-process.png";
import { services } from "../../data/services.js";

const title = "Services | ASquare";
const description =
  "Explore ASquare services: custom software development, data engineering & BI, cloud & DevOps engineering, software modernization, IT services, and Infor XA ERP.";
---

<BaseLayout title={title} description={description}>
  <div class="page-services-index">
    <section class="hero-section gutter">
      <div class="wrap hero-inner">
        <div class="hero-top">
          <div class="breadcrumbs">
            <a href="/">Home</a><span>/</span><span>Services</span>
          </div>
          <div class="hero-image">
            <img src={servicesHero.src} alt="ASquare engineers at work" />
          </div>
        </div>
        <div class="hero-copy">
          <h1>What we do</h1>
          <p>
            We work across custom software, data engineering and business
            intelligence, cloud and DevOps, modernization, and enterprise ERP -
            domains that most firms treat as separate practices. Our engagements
            combine them by default, because your ERP data doesn't stop at the
            edge of a dashboard.
          </p>
        </div>
      </div>
    </section>

    <section class="services-section gutter">
      <div class="wrap services-grid">
        {
          services.map((service) => (
            <a href={`/services/${service.slug}`} class="card service-card">
              <i
                data-lucide={service.icon}
                aria-hidden="true"
                class="service-icon"
              />
              <div class="service-card-body">
                <span class="service-title">{service.title}</span>
                <span class="service-desc">{service.shortDescription}</span>
              </div>
              <div class="service-arrow">
                <i data-lucide="arrow-up-right" aria-hidden="true" />
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section class="process-section gutter">
      <div class="wrap process-inner">
        <div class="process-copy">
          <div class="section-heading">
            <span class="eyebrow">How we work</span>
            <h2>Our Process</h2>
          </div>
          <p>
            Every engagement runs on an agile delivery model — short, focused
            sprints that end with working software, and priorities you can adjust
            as the work reveals what matters most. No big-bang releases, no
            surprises at the finish line.
          </p>
          <p>
            We plan and track all of it in Jira, so you always have a live view
            of scope, progress, and what's shipping next. Sprint planning,
            reviews, and backlog grooming happen with your team in the room —
            you're part of the process, not an audience for it.
          </p>
          <ul class="process-points">
            <li>Two-week sprints with demoable outcomes</li>
            <li>Shared Jira board for full visibility</li>
            <li>Regular reviews and transparent reporting</li>
          </ul>
        </div>
        <div class="process-media">
          <Image
            src={ourProcess}
            alt="ASquare's agile delivery process tracked in Jira"
            widths={[480, 720, 1080, 1320]}
            sizes="(max-width: 900px) 100vw, 620px"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <CtaBanner />
  </div>
</BaseLayout>
