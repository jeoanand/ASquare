---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CtaBanner from "../components/CtaBanner.astro";
import aboutIntro from "../assets/img/about-intro.png";
import avatarDavid from "../assets/img/about-avatar-david.png";
import avatar1 from "../assets/img/about-avatar-1.png";
import avatar2 from "../assets/img/about-avatar-2.png";

const title = "About Asquare | Enterprise Expertise. Modern Engineering.";
const description =
  "Asquare is a technology and software engineering company operating across Canada, Australia, and the United States, specializing in Infor XA expertise and modern software engineering.";

const breadcrumbs = [{ label: "Home", href: "/" }, { label: "About" }];

const team = [
  {
    photo: avatarDavid,
    name: "David Thorne",
    role: "Founding Engineer",
    bio: "15 years of Infor XA and custom .NET architecture.",
  },
  {
    photo: avatar1,
    name: "Sarah Chen",
    role: "Head of AI Integration",
    bio: "Formerly lead ML architect for industrial automation firms.",
  },
  {
    photo: avatar2,
    name: "Marcus Lowe",
    role: "Director of Delivery",
    bio: "Ensuring complex cloud migrations happen without a minute of downtime.",
  },
];

const values = [
  {
    icon: "network",
    title: "Know the Complex",
    desc: "Complex enterprise technology is where our expertise runs deep. We understand Infor XA and the environments businesses rely on every day.",
  },
  {
    icon: "compass",
    title: "Build with Purpose",
    desc: "Technology designed around real business needs, not built for its own sake.",
  },
  {
    icon: "check-circle",
    title: "Deliver with Confidence",
    desc: "Transparent execution without unnecessary complexity.",
  },
  {
    icon: "trending-up",
    title: "Grow Together",
    desc: "A technology partner for the long term — we stay engaged as your needs evolve.",
  },
];
---

<BaseLayout title={title} description={description}>
  <section class="intro-section gutter">
    <div class="wrap intro-inner">
      <Breadcrumbs items={breadcrumbs} />
      <div class="intro-image">
        <img
          src={aboutIntro.src}
          alt="The ASquare team collaborating in the office"
        />
      </div>
      <div class="intro-copy">
        <h1>Enterprise Expertise. Modern Engineering.</h1>
        <div class="intro-paragraphs">
          <p>
            Asquare is a technology and software engineering company operating
            across Canada, Australia, and the United States. We help businesses
            solve complex technology challenges through specialized Infor XA
            expertise and modern software engineering.
          </p>
          <p>
            Our services span Infor XA, software development, system
            modernization, data and business intelligence, cloud, DevOps, and
            integration — supporting both enterprise systems and broader
            technology initiatives.
          </p>
          <p>
            We work as an extension of your team, combining technical expertise
            with business understanding to deliver practical, scalable solutions
            that create lasting value.
          </p>
          <p class="intro-tagline">
            Asquare — Deep enterprise expertise. Modern technology. One trusted
            partner.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mission-vision-section gutter">
    <div class="wrap mission-vision-grid">
      <div class="mission-vision-col">
        <span class="eyebrow">Mission</span>
        <p>
          To simplify complex business challenges through connected, intuitive,
          and scalable digital solutions.
        </p>
      </div>
      <div class="mission-vision-col">
        <span class="eyebrow">Vision</span>
        <p>
          To become a trusted global engineering partner for modernizing
          mission-critical systems and powering digital transformation.
        </p>
      </div>
    </div>
  </section>

  <section class="leadership-section gutter">
    <div class="wrap leadership-inner">
      <div class="section-heading">
        <span class="eyebrow">Leadership</span>
        <h2>Who you'll work with</h2>
      </div>
      <div class="team-grid">
        {
          team.map((m) => (
            <div class="team-member">
              <div class="team-photo">
                <img src={m.photo.src} alt={m.name} />
              </div>
              <div class="team-meta">
                <span class="team-name">{m.name}</span>
                <span class="team-role">{m.role}</span>
                <span class="team-bio">{m.bio}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="values-section gutter">
    <div class="wrap values-inner">
      <div class="section-heading">
        <span class="eyebrow">Why Asquare</span>
        <h2>Think beyond the obvious</h2>
        <p class="values-intro">
          We bring together enterprise expertise, modern engineering, and
          practical thinking to turn complex technology challenges into
          opportunities.
        </p>
      </div>
      <div class="values-grid">
        {
          values.map((v) => (
            <div class="card value-card">
              <i data-lucide={v.icon} aria-hidden="true" />
              <div class="value-body">
                <span class="value-title">{v.title}</span>
                <span class="value-desc">{v.desc}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  .intro-section {
    padding-block: 120px 120px;
  }

  .intro-inner {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .intro-image {
    height: 400px;
    border-radius: 12px;
    overflow: hidden;
  }

  .intro-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .intro-copy {
    display: flex;
    flex-wrap: wrap;
    gap: 60px;
    margin-top: 60px;
  }

  .intro-copy h1 {
    font-weight: 700;
    font-size: clamp(32px, 5vw, 56px);
    color: var(--text);
    flex: 0 0 auto;
    width: 400px;
  }

  .intro-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 32px;
    flex: 1 1 400px;
    max-width: 700px;
  }

  .intro-paragraphs p {
    font-weight: 400;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text);
  }

  .intro-tagline {
    font-weight: 700;
    color: var(--text);
  }

  .mission-vision-section {
    padding-block: 0 100px;
  }

  .mission-vision-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }

  .mission-vision-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .mission-vision-col p {
    font-weight: 400;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .leadership-section {
    background: linear-gradient(
      180deg,
      rgba(154, 148, 224, 0.12) 54%,
      rgba(84, 73, 215, 0.05) 100%
    );
    padding-block: 100px;
  }

  .leadership-inner {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .section-heading {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .eyebrow {
    font-weight: 700;
    font-size: 14px;
    color: var(--accent);
    text-transform: uppercase;
  }

  .section-heading h2 {
    font-weight: 700;
    font-size: clamp(28px, 4vw, 40px);
    color: var(--text);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 40px;
  }

  .team-member {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .team-photo {
    width: 120px;
    height: 120px;
    border-radius: 60px;
    overflow: hidden;
  }

  .team-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .team-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .team-name {
    font-weight: 700;
    font-size: 20px;
    color: var(--text);
  }

  .team-role {
    font-weight: 600;
    font-size: 15px;
    color: var(--accent);
  }

  .team-bio {
    font-weight: 400;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .values-section {
    padding-block: 0 100px;
  }

  .values-inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .values-intro {
    font-weight: 400;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 700px;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 32px;
  }

  .value-card {
    border-radius: 4px;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--border);
    padding: 48px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .value-card :global(svg) {
    width: 32px;
    height: 32px;
    color: var(--accent);
  }

  .value-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .value-title {
    font-weight: 600;
    font-size: 20px;
    color: var(--text);
  }

  .value-desc {
    font-weight: 400;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .intro-section {
      padding-top: 110px;
    }

    .intro-image {
      height: 220px;
    }

    .intro-copy h1 {
      width: 100%;
    }

    .mission-vision-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
