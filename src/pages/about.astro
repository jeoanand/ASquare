---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CtaBanner from "../components/CtaBanner.astro";
import aboutIntro from "../assets/img/about-intro.png";
import missionImg from "../assets/img/about-mission.png";
import visionImg from "../assets/img/about-vision.png";
import avatarDavid from "../assets/img/about-avatar-david.png";
import avatar1 from "../assets/img/about-avatar-1.png";
import avatar2 from "../assets/img/about-avatar-2.png";

const title = "About Asquare | Enterprise Expertise. Modern Engineering.";
const description =
  "Asquare is a technology and software engineering company operating across Canada, Australia, and the United States, specializing in Infor XA expertise and modern software engineering.";

const breadcrumbs = [{ label: "Home", href: "/" }, { label: "About" }];

const team = [
  {
    photo: avatarDavid,
    name: "David Thorne",
    role: "Founding Engineer",
    bio: "15 years of Infor XA and custom .NET architecture.",
  },
  {
    photo: avatar1,
    name: "Sarah Chen",
    role: "Head of AI Integration",
    bio: "Formerly lead ML architect for industrial automation firms.",
  },
  {
    photo: avatar2,
    name: "Marcus Lowe",
    role: "Director of Delivery",
    bio: "Ensuring complex cloud migrations happen without a minute of downtime.",
  },
];

const values = [
  {
    icon: "network",
    title: "Know the Complex",
    desc: "Complex enterprise technology is where our expertise runs deep. We understand Infor XA and the environments businesses rely on every day.",
  },
  {
    icon: "compass",
    title: "Build with Purpose",
    desc: "Technology designed around real business needs, not built for its own sake.",
  },
  {
    icon: "check-circle",
    title: "Deliver with Confidence",
    desc: "Transparent execution without unnecessary complexity.",
  },
  {
    icon: "trending-up",
    title: "Grow Together",
    desc: "A technology partner for the long term — we stay engaged as your needs evolve.",
  },
];
---

<BaseLayout title={title} description={description}>
  <section class="intro-section gutter">
    <div class="wrap intro-inner">
      <Breadcrumbs items={breadcrumbs} />
      <div class="intro-image">
        <img
          src={aboutIntro.src}
          alt="The ASquare team collaborating in the office"
        />
      </div>
      <div class="intro-copy">
        <h1>Enterprise Expertise. Modern Engineering.</h1>
        <div class="intro-paragraphs">
          <p>
            Asquare is a technology and software engineering company operating
            across <strong>Canada, Australia, and the United States</strong>. We
            help businesses solve complex technology challenges through
            specialized Infor XA expertise and modern software engineering.
          </p>
          <p>
            Our services span <strong>Infor XA, software development, system
            modernization, data and business intelligence, cloud, DevOps, and
            integration</strong> — supporting both enterprise systems and broader
            technology initiatives.
          </p>
          <p>
            We work as an extension of your team, combining technical expertise
            with business understanding to deliver practical, scalable solutions
            that create lasting value.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="approach-section gutter">
    <div class="wrap approach-inner">
      <p class="approach-tagline">
        <span class="approach-tagline-brand">Asquare</span>
        <span class="approach-tagline-dash" aria-hidden="true">—</span>
        <span class="approach-tagline-line">Deep enterprise expertise.</span>
        <span class="approach-tagline-line">Modern technology.</span>
        <span class="approach-tagline-line">One trusted partner.</span>
      </p>
      <div class="approach-grid">
        <div class="approach-item">
          <span class="approach-step">01</span>
          <h3>Master the Complex</h3>
          <p>
            Complex enterprise technology is where our expertise runs deep. We
            understand Infor XA and the environments that businesses rely on
            every day.
          </p>
        </div>
        <div class="approach-item">
          <span class="approach-step">02</span>
          <h3>Build the New</h3>
          <p>
            Our engineering teams independently design and build modern software,
            applications, data platforms, and cloud solutions that solve today's
            business challenges.
          </p>
        </div>
        <div class="approach-item">
          <span class="approach-step">03</span>
          <h3>Stay for the Journey</h3>
          <p>
            We believe the best technology partnerships go beyond delivery. We
            stay engaged, understand how your needs evolve, and help your
            technology keep pace with your business.
          </p>
        </div>
      </div>
      <p class="approach-closer">Complex made possible</p>
    </div>
  </section>

  <section class="about-split gutter">
    <div class="wrap about-split-inner">
      <div class="about-split-media">
        <img src={missionImg.src} alt="ASquare engineers working through a client's systems" />
      </div>
      <div class="about-split-copy">
        <span class="eyebrow">Mission</span>
        <h2>
          To simplify complex business challenges through connected, intuitive,
          and scalable digital solutions.
        </h2>
        <p>
          Whether it's an Infor XA environment that needs modernising or
          fragmented data that needs to become a single source of truth, we focus
          on removing friction rather than adding tools. Every engagement is
          measured against one standard: does it make the day-to-day work of your
          operations, finance, and IT teams measurably easier?
        </p>
        <p>
          We work as an extension of your team, pairing deep enterprise knowledge
          with modern engineering practice — so the systems your business relies
          on stay dependable while they evolve.
        </p>
      </div>
    </div>
  </section>

  <section class="about-split about-split-reverse gutter">
    <div class="wrap about-split-inner">
      <div class="about-split-media">
        <img src={visionImg.src} alt="A modern enterprise technology environment" />
      </div>
      <div class="about-split-copy">
        <span class="eyebrow">Vision</span>
        <h2>
          To become a trusted global engineering partner for modernizing
          mission-critical systems and powering digital transformation.
        </h2>
        <p>
          We want to be the partner enterprises turn to when the ERP platforms,
          data pipelines, and cloud infrastructure their business runs on need to
          move forward without downtime or disruption.
        </p>
        <p>
          As technology and AI reshape how businesses operate, our vision is to
          help established companies adopt what is genuinely useful on a stable
          foundation — across Canada, Australia, and the United States, and
          wherever our clients grow next.
        </p>
      </div>
    </div>
  </section>

  <section class="leadership-section gutter">
    <div class="wrap leadership-inner">
      <div class="section-heading">
        <span class="eyebrow">Leadership</span>
        <h2>Who you'll work with</h2>
      </div>
      <div class="team-grid">
        {
          team.map((m) => (
            <div class="team-member">
              <div class="team-photo">
                <img src={m.photo.src} alt={m.name} />
              </div>
              <div class="team-meta">
                <span class="team-name">{m.name}</span>
                <span class="team-role">{m.role}</span>
                <span class="team-bio">{m.bio}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="values-section gutter">
    <div class="wrap values-inner">
      <div class="section-heading">
        <span class="eyebrow">Why Asquare</span>
        <h2>Think beyond the obvious</h2>
        <p class="values-intro">
          We bring together enterprise expertise, modern engineering, and
          practical thinking to turn complex technology challenges into
          opportunities.
        </p>
      </div>
      <div class="values-grid">
        {
          values.map((v) => (
            <div class="card value-card">
              <i data-lucide={v.icon} aria-hidden="true" />
              <div class="value-body">
                <span class="value-title">{v.title}</span>
                <span class="value-desc">{v.desc}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  .intro-section {
    padding-block: 120px 120px;
  }

  .intro-inner {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .intro-image {
    height: 400px;
    border-radius: 12px;
    overflow: hidden;
  }

  .intro-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .intro-copy {
    display: flex;
    flex-wrap: wrap;
    gap: 60px;
    margin-top: 60px;
  }

  .intro-copy h1 {
    font-weight: 700;
    font-size: clamp(32px, 5vw, 56px);
    color: var(--text);
    flex: 0 0 auto;
    width: 400px;
  }

  .intro-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 32px;
    flex: 1 1 400px;
    max-width: 700px;
  }

  .intro-paragraphs p {
    font-weight: 400;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text);
  }

  .approach-section {
    padding-block: 0 100px;
  }

  .approach-inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .approach-tagline {
    margin: 0;
    padding-left: 20px;
    border-left: 3px solid var(--accent);
    font-size: clamp(18px, 2.4vw, 22px);
    line-height: 1.5;
  }

  .approach-tagline-brand {
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.3px;
  }

  .approach-tagline-dash {
    margin: 0 8px;
    color: var(--text-subtle);
  }

  .approach-tagline-line {
    font-weight: 600;
    color: var(--accent);
  }

  .approach-tagline-line:not(:last-child)::after {
    content: "·";
    margin: 0 8px;
    color: var(--text-subtle);
    font-weight: 400;
  }

  .approach-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 40px;
  }

  .approach-item {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .approach-step {
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 1px;
    color: var(--accent);
  }

  .approach-item h3 {
    margin: 0;
    font-weight: 700;
    font-size: 20px;
    color: var(--text);
  }

  .approach-item p {
    margin: 0;
    font-weight: 400;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .approach-closer {
    margin: 0;
    padding-top: 8px;
    border-top: 1px solid var(--border);
    font-weight: 800;
    font-size: clamp(24px, 4vw, 34px);
    letter-spacing: -0.5px;
    color: var(--text);
  }

  .about-split {
    padding-block: 0 100px;
  }

  .about-split-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .about-split-reverse .about-split-media {
    order: 2;
  }

  .about-split-media {
    height: 380px;
    border-radius: 12px;
    overflow: hidden;
    background: var(--border);
  }

  .about-split-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-split-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .about-split-copy h2 {
    font-weight: 700;
    font-size: clamp(22px, 3vw, 30px);
    line-height: 1.3;
    color: var(--text);
  }

  .about-split-copy p {
    font-weight: 400;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .leadership-section {
    background: #f1f0fb;
    border-block: 1px solid rgba(84, 73, 215, 0.12);
    padding-block: 100px;
  }

  .leadership-inner {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .section-heading {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .eyebrow {
    font-weight: 700;
    font-size: 14px;
    color: var(--accent);
    text-transform: uppercase;
  }

  .section-heading h2 {
    font-weight: 700;
    font-size: clamp(28px, 4vw, 40px);
    color: var(--text);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 40px;
  }

  .team-member {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .team-photo {
    width: 120px;
    height: 120px;
    border-radius: 60px;
    overflow: hidden;
  }

  .team-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .team-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .team-name {
    font-weight: 700;
    font-size: 20px;
    color: var(--text);
  }

  .team-role {
    font-weight: 600;
    font-size: 15px;
    color: var(--accent);
  }

  .team-bio {
    font-weight: 400;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .values-section {
    padding-block: 100px;
  }

  .values-inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .values-intro {
    font-weight: 400;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 700px;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 32px;
  }

  .value-card {
    border-radius: 4px;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--border);
    padding: 48px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .value-card :global(svg) {
    width: 32px;
    height: 32px;
    color: var(--accent);
  }

  .value-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .value-title {
    font-weight: 600;
    font-size: 20px;
    color: var(--text);
  }

  .value-desc {
    font-weight: 400;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .intro-section {
      padding-top: 110px;
    }

    .intro-image {
      height: 220px;
    }

    .intro-copy h1 {
      width: 100%;
    }

    .about-split-inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .about-split-media {
      height: 240px;
    }

    .about-split-reverse .about-split-media {
      order: 0;
    }
  }
</style>
