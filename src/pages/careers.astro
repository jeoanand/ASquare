---
import BaseLayout from "../layouts/BaseLayout.astro";
import careersHero from "../assets/img/careers-hero.png";

const title = "Careers | ASquare";
const description =
  "Join ASquare and work on production systems for enterprise clients—no account handoffs, direct client contact, real ownership.";

const culture = [
  { icon: "home", label: "Remote-first work" },
  { icon: "users", label: "Small focused team" },
  { icon: "phone", label: "Direct client contact" },
  { icon: "clock", label: "No timesheets" },
  { icon: "award", label: "Real ownership" },
  { icon: "dollar-sign", label: "Transparent salaries" },
];
---

<BaseLayout title={title} description={description}>
  <section class="hero-section gutter">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <span class="breadcrumb-label">Home / Careers</span>
        <div class="hero-copy-inner">
          <div class="hero-heading">
            <span class="eyebrow">Working with us</span>
            <h1>Work that's technical all the way down</h1>
          </div>
          <p>
            We're a small team that builds and runs production systems for
            enterprise clients. There are no account management handoffs or
            delivery managers between you and the work. If you're on a project,
            you're the engineer. You read the schema, write the code, and talk
            directly to the client.
          </p>
          <p>
            We work across .NET, React, Azure, Power BI, Infor XA, and AI
            toolchains. The common thread is systems integration — connecting
            things that should talk to each other but don't yet.
          </p>
        </div>
      </div>
      <div class="hero-image">
        <img src={careersHero.src} alt="ASquare team photo" />
      </div>
    </div>
  </section>

  <section class="culture-section gutter">
    <div class="wrap culture-inner">
      <div class="section-heading">
        <span class="eyebrow">What working here looks like</span>
        <h2>A culture built for engineers</h2>
      </div>
      <div class="culture-grid">
        {
          culture.map((c) => (
            <div class="culture-item">
              <div class="culture-icon">
                <i data-lucide={c.icon} aria-hidden="true" />
              </div>
              <span>{c.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="roles-section gutter">
    <div class="wrap roles-heading">
      <span class="eyebrow">Current openings</span>
      <h2>Open roles</h2>
    </div>
    <div class="roles-card">
      <div class="roles-card-inner">
        <div class="roles-icon">
          <i data-lucide="briefcase" aria-hidden="true"></i>
        </div>
        <span class="roles-title">No open roles right now</span>
        <span class="roles-desc">
          We hire when we find the right person, not to fill a quota. If you're
          interested in what we do, send us your CV and what you'd want to work
          on.
        </span>
      </div>
      <a href="/contact" class="btn-dark">Send us your CV</a>
    </div>
  </section>

  <section class="cta-section gutter">
    <div class="cta-copy">
      <h2>Not seeing a fit right now?</h2>
      <p>
        Send us your details and what you'd want to work on. We'll reach out
        when the time is right.
      </p>
    </div>
    <a href="/contact" class="btn-outline">Get in touch</a>
  </section>
</BaseLayout>

<style>
  .hero-section {
    padding-block: 190px 80px;
  }

  .hero-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 100px;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex: 1 1 400px;
  }

  .breadcrumb-label {
    font-weight: 400;
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(110, 116, 126);
    text-transform: uppercase;
  }

  .hero-copy-inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .hero-heading {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .eyebrow {
    font-weight: 700;
    font-size: 14px;
    color: var(--accent);
    text-transform: uppercase;
  }

  .hero-heading h1 {
    font-weight: 700;
    font-size: clamp(28px, 4vw, 40px);
    color: var(--text);
  }

  .hero-copy-inner p {
    font-weight: 400;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .hero-image {
    flex: 1 1 400px;
    min-height: 400px;
    border-radius: 8px;
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .culture-section {
    padding-block: 120px;
  }

  .culture-inner {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .section-heading {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .section-heading h2 {
    font-weight: 700;
    font-size: clamp(28px, 4vw, 40px);
    color: var(--text);
  }

  .culture-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .culture-item {
    border-radius: 4px;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--border);
    padding: 24px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .culture-icon {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: rgb(243, 244, 255);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .culture-icon :global(svg) {
    width: 20px;
    height: 20px;
    color: var(--accent);
  }

  .culture-item span {
    font-weight: 600;
    font-size: 16px;
    color: var(--text);
  }

  .roles-section {
    background: linear-gradient(
      180deg,
      rgba(154, 148, 224, 0.12) 54%,
      rgba(84, 73, 215, 0.05) 100%
    );
    padding-block: 80px 100px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 60px;
  }

  .roles-heading {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .roles-heading h2 {
    font-weight: 700;
    font-size: clamp(28px, 4vw, 40px);
    color: var(--text);
  }

  .roles-card {
    max-width: 600px;
    width: 100%;
    background: #fff;
    border-radius: 12px;
    outline: 1px dashed var(--border);
    outline-offset: -1px;
    padding: 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    box-sizing: border-box;
  }

  .roles-card-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  .roles-icon {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .roles-icon :global(svg) {
    width: 24px;
    height: 24px;
    color: rgb(207, 209, 212);
  }

  .roles-title {
    font-weight: 600;
    font-size: 20px;
    color: var(--text);
  }

  .roles-desc {
    font-weight: 400;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .btn-dark {
    background: transparent;
    border: 1px solid rgb(14, 24, 40);
    color: var(--text);
    font-weight: 600;
    font-size: 14px;
    padding: 12px 24px;
    border-radius: 4px;
  }

  .btn-dark:hover {
    background: var(--text);
    color: #fff;
  }

  .cta-section {
    background: var(--accent);
    padding-block: 120px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    text-align: center;
  }

  .cta-copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 661px;
  }

  .cta-copy h2 {
    font-weight: 700;
    font-size: clamp(28px, 5vw, 48px);
    color: #fff;
  }

  .cta-copy p {
    font-weight: 400;
    font-size: 18px;
    color: rgba(255, 255, 255, 0.8);
  }

  .btn-outline {
    display: inline-block;
    background: transparent;
    color: #fff;
    border: 1px solid #fff;
    font-weight: 600;
    font-size: 16px;
    padding: 16px 32px;
    border-radius: 4px;
  }

  .btn-outline:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }

  @media (max-width: 900px) {
    .hero-section {
      padding-top: 110px;
    }

    .hero-image {
      min-height: 260px;
    }

    .roles-card {
      padding: 40px;
    }
  }
</style>
