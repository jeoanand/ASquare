---
import BaseLayout from "../layouts/BaseLayout.astro";
import facebookIcon from "../assets/img/facebook.svg?url";
import instagramIcon from "../assets/img/instagram.svg?url";
import linkedinIcon from "../assets/img/linkedin.svg?url";
import whatsappIcon from "../assets/img/whatsapp.svg?url";
import xIcon from "../assets/img/x.svg?url";

const title = "Contact | ASquare";
const description =
  "Contact ASquare to discuss your project. Custom software, data engineering, cloud & DevOps, modernization, IT, and Infor XA ERP.";

const mapsShareUrl = "https://maps.app.goo.gl/EuywYXVidA3q1JJa9?g_st=aw";
const mapsEmbedSrc =
  "https://maps.google.com/maps?q=6865+Shade+House+Crt,+Mississauga,+Ontario,+L5W+1C3,+Canada&output=embed";

const contactJsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contact ASquare",
  url: Astro.url.href,
  description,
  mainEntity: {
    "@type": "Organization",
    name: "ASquare Technologies LLC",
    telephone: "+1-437-449-0275",
    address: {
      "@type": "PostalAddress",
      streetAddress: "6865 Shade House Crt",
      addressLocality: "Mississauga",
      addressRegion: "Ontario",
      postalCode: "L5W 1C3",
      addressCountry: "CA",
    },
  },
};

const serviceOptions = [
  "Infor XA ERP",
  "Custom Software Development",
  "Data Engineering & Business Intelligence",
  "Cloud & DevOps Engineering",
  "Software Modernization & Refactoring",
  "IT Consulting",
];

const socialLinks = [
  { href: "#", label: "Facebook", icon: facebookIcon },
  { href: "#", label: "Instagram", icon: instagramIcon },
  { href: "#", label: "LinkedIn", icon: linkedinIcon },
  { href: "#", label: "WhatsApp", icon: whatsappIcon },
  { href: "#", label: "X (Twitter)", icon: xIcon },
];

// Google's shared test key (always passes, works on localhost). Set
// PUBLIC_RECAPTCHA_SITE_KEY in .env to your real key before deploying —
// register one for this domain at https://www.google.com/recaptcha/admin.
const recaptchaSiteKey =
  import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY ??
  "6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI";
---

<BaseLayout title={title} description={description}>
  <Fragment slot="jsonld">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(contactJsonLd)}
    />
  </Fragment>

  <script
    is:inline
    src="https://www.google.com/recaptcha/api.js"
    async
    defer
  ></script>

  <section class="contact-section gutter">
    <div class="wrap contact-inner">
      <div class="contact-main">
        <div class="contact-heading">
          <h1>Start a conversation</h1>
          <p>
            We respond to every enquiry. No sales handoff — you'll hear from one
            of the engineers.
          </p>
        </div>
        <form class="contact-form" id="contact-form">
          <div class="fields">
            <label class="field">
              <span>Name</span>
              <div class="field-input">
                <input
                  class="f"
                  type="text"
                  name="name"
                  placeholder="Your name"
                  required
                />
                <i data-lucide="user" class="field-icon" aria-hidden="true"></i>
              </div>
            </label>
            <label class="field">
              <span>Email</span>
              <div class="field-input">
                <input
                  class="f"
                  type="email"
                  name="email"
                  placeholder="email@asquaretechservices.com"
                  required
                />
                <i data-lucide="mail" class="field-icon" aria-hidden="true"></i>
              </div>
            </label>
            <label class="field">
              <span>Phone (Optional)</span>
              <div class="field-input">
                <input
                  class="f"
                  type="tel"
                  name="phone"
                  placeholder="+1 XXX XXX XXXX"
                />
                <i data-lucide="phone" class="field-icon" aria-hidden="true"></i>
              </div>
            </label>
            <label class="field">
              <span>Service Interest</span>
              <div class="field-input">
                <select class="f" name="service">
                  {serviceOptions.map((option) => <option>{option}</option>)}
                </select>
                <i data-lucide="chevron-down" class="field-icon" aria-hidden="true"></i>
              </div>
            </label>
            <label class="field">
              <span>Message</span>
              <div class="field-input field-input--textarea">
                <textarea
                  class="f"
                  name="message"
                  placeholder="Tell us about your project requirements..."
                  required></textarea>
                <i data-lucide="message-square" class="field-icon" aria-hidden="true"></i>
              </div>
            </label>
          </div>
          <div class="captcha-field">
            <div class="g-recaptcha" data-sitekey={recaptchaSiteKey}></div>
            <span class="captcha-error" id="captcha-error" hidden
              >Please verify you're not a robot before sending.</span
            >
          </div>
          <button type="submit" class="btn-primary">Send message</button>
          <div class="success-message" id="contact-success" hidden>
            <i data-lucide="check-circle" aria-hidden="true"></i>
            <span
              >Message sent — we'll be in touch within one business day.</span
            >
          </div>
        </form>
      </div>

      <div class="contact-aside">
        <div class="contact-card">
          <a
            class="contact-map"
            href={mapsShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Open ASquare's Mississauga office in Google Maps"
          >
            <iframe
              src={mapsEmbedSrc}
              title="Map of ASquare's Mississauga office"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </a>
          <div class="contact-card-body">
            <div class="contact-org">
              <span class="contact-org-name">ASquare Technologies LLC</span>
              <span class="contact-org-address"
                >6865 Shade House Crt, Mississauga, Ontario, L5W 1C3, Canada</span
              >
            </div>
            <div class="contact-details">
              <a class="contact-detail" href="mailto:info@asquaretechservices.com">
                <i data-lucide="mail" aria-hidden="true"></i>
                <span>info@asquaretechservices.com</span>
              </a>
              <div class="contact-detail">
                <i data-lucide="phone" aria-hidden="true"></i>
                <span>+1 437 449 0275</span>
              </div>
            </div>
            <div class="contact-icons">
              {
                socialLinks.map(({ href, label, icon }) => (
                  <a href={href} aria-label={label}>
                    <img src={icon} alt="" width="20" height="20" loading="lazy" />
                  </a>
                ))
              }
            </div>
          </div>
        </div>
        <div class="response-time">
          <span class="response-label">Response time</span>
          <span class="response-value">We will reply shortly!</span>
          <p class="response-note">
            Our business team will personally review your enquiry and keep in
            touch with you at every step until we have the right solution in
            place.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-section {
    padding-block: 120px 120px;
  }

  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 480px;
    gap: 100px;
  }

  .contact-main {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .contact-heading {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .contact-heading h1 {
    font-weight: 700;
    font-size: clamp(32px, 5vw, 56px);
    color: var(--text);
  }

  .contact-heading p {
    font-weight: 400;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 32px;
    width: 100%;
  }

  .fields {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  .field span {
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.5px;
    color: var(--text);
    text-transform: uppercase;
  }

  .field-input {
    position: relative;
    display: flex;
  }

  .f {
    border-radius: 4px;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--border);
    border: none;
    padding: 0 40px 0 12px;
    height: 48px;
    width: 100%;
    font-family: inherit;
    font-size: 14px;
    color: var(--text);
    box-sizing: border-box;
  }

  select.f {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
  }

  textarea.f {
    padding: 12px 40px 12px 12px;
    height: 140px;
    resize: vertical;
  }

  .f::placeholder {
    color: rgb(110, 116, 126);
  }

  .field-icon {
    position: absolute;
    top: 50%;
    right: 14px;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    color: rgb(110, 116, 126);
    pointer-events: none;
  }

  .field-input--textarea .field-icon {
    top: 16px;
    transform: none;
  }

  .captcha-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .captcha-error {
    font-weight: 500;
    font-size: 13px;
    color: rgb(220, 38, 38);
  }

  .captcha-error[hidden] {
    display: none;
  }

  .btn-primary {
    background: var(--accent);
    color: #fff;
    border: none;
    font-weight: 600;
    font-size: 16px;
    padding: 16px 32px;
    border-radius: 4px;
    cursor: pointer;
    width: fit-content;
  }

  .btn-primary:hover {
    background: var(--accent-dark);
  }

  .success-message {
    border-radius: 4px;
    background: #fff;
    box-shadow: inset 0 0 0 1px rgb(41, 170, 88);
    display: flex;
    gap: 12px;
    padding: 16px;
    align-items: center;
  }

  .success-message[hidden] {
    display: none;
  }

  .success-message :global(svg) {
    width: 20px;
    height: 20px;
    color: rgb(41, 170, 88);
    flex-shrink: 0;
  }

  .success-message span {
    font-weight: 500;
    font-size: 14px;
    color: rgb(22, 163, 74);
  }

  .contact-aside {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .contact-card {
    border-radius: 8px;
    background: #fff;
    box-shadow:
      inset 0 0 0 1px var(--border),
      0 4px 20px rgba(0, 0, 0, 0.02);
    overflow: hidden;
  }

  .contact-map {
    display: block;
    height: 240px;
  }

  .contact-map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    pointer-events: none;
  }

  .contact-card-body {
    border-top: 1px solid var(--border);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .contact-org {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .contact-org-name {
    font-weight: 700;
    font-size: 15px;
    color: var(--text);
  }

  .contact-org-address {
    font-weight: 400;
    font-size: 14px;
    color: var(--text-muted);
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .contact-detail {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .contact-detail :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--accent);
  }

  .contact-detail span {
    font-weight: 400;
    font-size: 15px;
    color: var(--text);
  }

  .contact-icons {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .contact-icons a {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 150ms ease;
  }

  .contact-icons a:hover,
  .contact-icons a:focus-visible {
    background: var(--accent-dark);
  }

  .contact-icons img {
    width: 16px;
    height: 16px;
  }

  .response-time {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .response-label {
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--accent);
    text-transform: uppercase;
  }

  .response-value {
    font-weight: 400;
    font-size: 24px;
    color: rgb(110, 116, 126);
  }

  .response-note {
    margin: 0;
    max-width: 420px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .contact-section {
      padding-top: 110px;
    }

    .contact-inner {
      grid-template-columns: 1fr;
    }

    .contact-map {
      height: 200px;
    }
  }
</style>

<script>
  declare global {
    interface Window {
      grecaptcha?: { getResponse: () => string; reset: () => void };
    }
  }

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const success = document.getElementById("contact-success");
  const captchaError = document.getElementById("captcha-error");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    const captchaResponse = window.grecaptcha?.getResponse();
    if (!captchaResponse) {
      captchaError?.removeAttribute("hidden");
      return;
    }
    captchaError?.setAttribute("hidden", "");

    success?.removeAttribute("hidden");
    form.reset();
    window.grecaptcha?.reset();
  });
</script>
