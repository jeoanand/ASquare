---
import logoWhite from "../assets/logo-white.png";
import facebookIcon from "../assets/img/facebook.svg?url";
import instagramIcon from "../assets/img/instagram.svg?url";
import linkedinIcon from "../assets/img/linkedin.svg?url";
import whatsappIcon from "../assets/img/whatsapp.svg?url";
import xIcon from "../assets/img/x.svg?url";

const year = new Date().getFullYear();

const socialLinks = [
  { href: "#", label: "Facebook", icon: facebookIcon },
  { href: "#", label: "Instagram", icon: instagramIcon },
  { href: "#", label: "LinkedIn", icon: linkedinIcon },
  { href: "#", label: "WhatsApp", icon: whatsappIcon },
  { href: "#", label: "X (Twitter)", icon: xIcon },
];

const companyLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/careers", label: "Careers" },
];

const serviceLinks = [
  { href: "/services/infor-xa-erp", label: "Infra XA" },
  { href: "/services/web-development", label: "Software Development" },
  { href: "/services/power-bi", label: "Data Engineering & BI" },
  { href: "/services/cloud-services", label: "Cloud & DevOps" },
  { href: "/services/software-modernization", label: "Modernization" },
  { href: "/services/it-services", label: "Technical Support" },
];

const connectLinks = [
  { href: "/contact", label: "Contact" },
  { href: "/terms-of-service", label: "Terms & Service" },
  { href: "/privacy-policy", label: "Privacy Policy" },
];
---

<footer class="site-footer">
  <div class="wrap gutter footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src={logoWhite.src} alt="A-Square" class="footer-logo" />
        <p>
          Enterprise-grade engineering for critical operations. We build systems
          that stay running.
        </p>
      </div>

      <div class="footer-col">
        <span class="footer-heading">Company</span>
        {companyLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
      </div>

      <div class="footer-col">
        <span class="footer-heading">Services</span>
        {serviceLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
      </div>

      <div class="footer-col">
        <span class="footer-heading">Connect</span>
        {connectLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
      </div>

      <div class="footer-col footer-newsletter">
        <span class="footer-heading">Newsletter</span>
        <form class="newsletter-form">
          <input
            type="email"
            placeholder="info@asquaretechservices.com"
            aria-label="Email address"
          />
          <button type="submit" aria-label="Subscribe">
            <i data-lucide="arrow-right" aria-hidden="true"></i>
          </button>
        </form>
        <div class="footer-icons">
          {
            socialLinks.map(({ href, label, icon }) => (
              <a href={href} aria-label={label}>
                <img src={icon} alt="" width="20" height="20" loading="lazy" />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} ASQUARE TECHNOLOGIES LLC.</span>
      <span class="footer-legal">
        <a href="/privacy-policy">Privacy Policy</a> / <a
          href="/terms-of-service">Terms of Service</a
        >
      </span>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll(".newsletter-form").forEach((form) => {
    form.addEventListener("submit", (event) => event.preventDefault());
  });
</script>
