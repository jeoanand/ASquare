---
import ctaBg from "../assets/img/cta-bg.jpg";

/** @type {{
	heading?: string;
	text?: string;
	buttonLabel?: string;
	buttonHref?: string;
}} */
const {
	heading = "Ready to start a conversation?",
	text = "We scope projects in a single call. No long sales cycles.",
	buttonLabel = "Talk to us",
	buttonHref = "/contact",
} = Astro.props;
---

<section
	class="cta-banner gutter"
	style={`background-image:linear-gradient(135deg, rgba(69,57,211,0.62), rgba(55,46,169,0.68)), url(${ctaBg.src})`}
>
	<div class="cta-banner-copy">
		<h2>{heading}</h2>
		<p>{text}</p>
	</div>
	<a href={buttonHref} class="cta-banner-btn">{buttonLabel}</a>
</section>
